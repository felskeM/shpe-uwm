{
  "name": "shpe-uwm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "start": "next start",
    "dev:worker": "npm run cf:build && opennextjs-cloudflare preview --port 8771",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "lint": "eslint .",
    "lint:debug": "eslint . --debug",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.136.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{css,md,mdx,json,yaml,yml}": "prettier --write"
  },
  "packageManager": "npm@11.12.1",
  "description": "SHPE UWM Website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felskeM/shpe-uwm.git"
  },
  "keywords": [],
  "author": "Matthew (Mateo) Felske",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/felskeM/shpe-uwm/issues"
  },
  "homepage": "https://shpeuwm.org/",
  "engines": {
    "node": "^22.22.1 || ^24.0.0"
  }
}
